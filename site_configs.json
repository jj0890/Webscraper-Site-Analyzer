{
  "configs": {

    "pi.fyi": {
      "url": "https://pi.fyi",
      "modal_selectors": ["[role='dialog']", "form[method='post']", "[class*='modal']", "[class*='overlay']", "[class*='signup']", "[class*='gate']"],
      "modal_strategy": "dom_remove",
      "unblock_scroll": true,
      "feed_container": "[class*='feed'], [class*='timeline'], main",
      "content_types": ["rec", "ask", "event", "editorial"],
      "content_classifiers": {
        "rec":       { "selectors": ["[class*='rec']"], "heuristics": ["short text", "external link"] },
        "ask":       { "selectors": ["[class*='ask']"], "heuristics": ["contains '?'", "reply thread"] },
        "event":     { "selectors": ["[class*='event']", "time[datetime]"], "heuristics": ["date + location"] },
        "editorial": { "selectors": ["article"], "heuristics": ["long-form > 200 words", "byline"] }
      },
      "infinite_scroll": { "enabled": true, "scroll_steps": 3, "wait_ms": 1500 },
      "api_hints": ["/api/", "/graphql", "/_next/data/", "/feed"],
      "notes": "Email-gate modal on landing. DOM remove strategy — modal is client-side only. Content schema is loose: recs, asks, events, editorial all share the same feed. Classify by heuristic not selector."
    },

    "soundcloud.com": {
      "url": "https://soundcloud.com",
      "modal_selectors": ["[class*='CookieBanner']", "[id*='cookie']", "[class*='consent']"],
      "modal_strategy": "click_close",
      "api_base": "https://api-v2.soundcloud.com",
      "api_endpoints": {
        "stream":  "/stream?limit=20&linked_partitioning=1",
        "search":  "/search/tracks?q={query}&limit=20",
        "user":    "/users/{id}/tracks"
      },
      "pagination": { "type": "cursor", "param": "linked_partitioning", "limit_param": "limit" },
      "notes": "Public API exists. client_id is embedded in page JS — intercept network tab to find it. No hard rate limit except 15k stream calls/day."
    },

    "nts.live": {
      "url": "https://www.nts.live",
      "modal_selectors": [],
      "api_base": "https://www.nts.live/api/v2",
      "api_endpoints": {
        "live":     "/live",
        "shows":    "/shows?limit=50&offset=0",
        "episodes": "/shows/{slug}/episodes?limit=20&offset=0",
        "search":   "/search?q={query}"
      },
      "pagination": { "type": "offset", "offset_param": "offset", "limit_param": "limit", "default_limit": 50 },
      "notes": "Open undocumented JSON API. No auth required. Pagination via offset/limit. Shows have genres, location, description."
    },

    "saintheron.com": {
      "url": "https://saintheron.com",
      "modal_selectors": [],
      "fonts": { "body": "Neue Haas Grotesk Display Pro 45", "display": "Cardinal Fruit" },
      "colors": { "background": "rgb(255,255,249)", "text": "rgb(0,0,0)", "border": "rgb(229,231,235)" },
      "layout": "24-column CSS grid, 10.5px gaps",
      "notes": "Cultural institution aesthetic. Monochrome (no accent). Tiny 14px body. Dense editorial grid. Cardinal Fruit serif for display headings. Reference site for Enamorado editorial direction."
    },

    "theverge.com": {
      "containerSelector": ".duet--content-cards--content-card, [class*='content-card']:not(.m-ad)",
      "titleSelectors": ["h2 a", "h2", "h3"],
      "excerptSelectors": ["p"],
      "authorSelectors": ["[class*='author']"],
      "dateSelectors": ["time"],
      "imageSelectors": ["img"],
      "notes": "Uses card-based layout - exclude ads with :not(.m-ad)"
    },
    "wired.com": {
      "containerSelector": "div[class*='CollageEnvironment'], div[class*='SummaryItem']",
      "titleSelectors": ["a[href*='/story/']", "h3 a", "[class*='Hed'] a"],
      "excerptSelectors": ["[class*='Dek']", "[class*='dek']", "p"],
      "authorSelectors": ["[class*='byline']", "[class*='Byline']", "[class*='author']"],
      "dateSelectors": ["time", "[class*='PublishDate']"],
      "imageSelectors": ["img"],
      "notes": "Complex layout - article titles are in links, not h2 elements"
    },
    "blog.github.com": {
      "containerSelector": "article.post-card",
      "titleSelectors": ["h2 a", ".post-card__link"],
      "excerptSelectors": ["p"],
      "authorSelectors": ["[class*='author']"],
      "dateSelectors": ["time"],
      "imageSelectors": ["img"],
      "notes": "Has proper article tags but needs specific title selector"
    },
    "medium.com": {
      "containerSelector": "article, div[class*='streamItem'], [data-testid='article']",
      "titleSelectors": ["h2", "h3", "h1"],
      "excerptSelectors": ["[class*='subtitle']", "h4", "p"],
      "additionalWait": 8000,
      "notes": "Heavy React hydration - needs 8+ second wait"
    },
    "polyesterzine.com": {
      "containerSelector": "li.slide, li.list-item",
      "titleSelectors": ["h2", "h3", "[class*='title']"],
      "excerptSelectors": ["p", "[class*='excerpt']", "[class*='description']"],
      "notes": "Squarespace carousel - uses li.slide elements"
    },
    "thisiscolossal.com": {
      "containerSelector": "article, [class*='post']",
      "titleSelectors": ["h2 a", "h1"],
      "excerptSelectors": ["[class*='excerpt']", "p"],
      "notes": "WordPress site with 142 articles - needs investigation"
    },
    "polygon.com": {
      "containerSelector": "[class*='entry']",
      "titleSelectors": ["h2 a", "h3 a"],
      "excerptSelectors": ["[class*='dek']", "p"],
      "notes": "Vox Media network site"
    },
    "engadget.com": {
      "containerSelector": "[class*='article'], [data-component='ArticleCard']",
      "titleSelectors": ["h2", "h3"],
      "excerptSelectors": ["p"],
      "notes": "Yahoo/Verizon media property"
    }
  },
  "defaultConfig": {
    "containerSelectors": [
      "article",
      "[class*='article']",
      "[class*='post']",
      "[class*='story']",
      "[class*='card']"
    ],
    "titleSelectors": [
      "h2 a",
      "h3 a",
      "h2",
      "h3",
      "h1",
      "[class*='title'] a",
      "[class*='headline'] a",
      "[class*='title']",
      "[class*='headline']"
    ],
    "excerptSelectors": [
      "[class*='excerpt']",
      "[class*='summary']",
      "[class*='description']",
      "p:not([class*='meta'])"
    ],
    "authorSelectors": [
      "[class*='author']",
      "[rel='author']",
      "[class*='byline']",
      "[class*='writer']"
    ],
    "dateSelectors": [
      "time",
      "[class*='date']",
      "[class*='published']"
    ],
    "imageSelectors": ["img"],
    "validationRules": {
      "title": {
        "minLength": 5,
        "maxLength": 200
      },
      "excerpt": {
        "minLength": 20,
        "maxLength": 500
      },
      "author": {
        "maxLength": 100
      },
      "date": {
        "maxLength": 50
      }
    }
  }
}
